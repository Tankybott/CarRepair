@model Model.ViewModel.ServiceTypeIndexVM

@{
    ViewData["Title"] = "Service Types";
}

<link href="https://unpkg.com/tabulator-tables@5.5.0/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
<script src="https://unpkg.com/tabulator-tables@5.5.0/dist/js/tabulator.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    .loading {
        cursor: wait !important;
    }
</style>

<div class="container mt-4 h-100">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Service Types</h2>

        <button class="btn btn-primary" onclick="openAddModal()">
            Add New
        </button>
    </div>

    <div id="serviceTypeTable"></div>
</div>

<div class="modal fade" id="addServiceTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="serviceTypeForm">

                <input type="hidden" id="serviceTypeId" />

                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Add Service Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" id="serviceTypeName" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control"
                                  id="serviceTypeDescription"
                                  minlength="30"
                                  required
                                  rows="3"></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>

            </form>
        </div>
    </div>
</div>


<script>
    var tableData = @Html.Raw(
    System.Text.Json.JsonSerializer.Serialize(
        Model.Items,
        new System.Text.Json.JsonSerializerOptions {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        }
    )
);

    var table = new Tabulator("#serviceTypeTable", {
        index: "id",
        data: tableData,
        layout: "fitColumns",
        pagination: "local",
        paginationSize: 10,
        height: "90%",
        movableColumns: true,
        responsiveLayout: "collapse",
        columns: [
            { title: "Name", field: "name", headerFilter: "input" },

            {
                title: "Actions",
                formatter: () => `
                    <button class="btn btn-sm btn-warning me-2 edit-btn">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button class="btn btn-sm btn-danger delete-btn">
                        <i class="bi bi-trash"></i>
                    </button>
                `,
                width: 120,
                hozAlign: "center",
                cellClick: (e, cell) => {
                    const data = cell.getRow().getData();

                    if (e.target.closest(".edit-btn")) openEditModal(data);
                    if (e.target.closest(".delete-btn")) deleteRow(data.id, cell.getRow());
                }
            }
        ]
    });

    function openAddModal() {
        document.getElementById("modalTitle").innerText = "Add Service Type";

        document.getElementById("serviceTypeId").value = "";
        document.getElementById("serviceTypeName").value = "";
        document.getElementById("serviceTypeDescription").value = "";

        new bootstrap.Modal(document.getElementById("addServiceTypeModal")).show();
    }

    function openEditModal(data) {
        document.getElementById("modalTitle").innerText = "Edit Service Type";

        document.getElementById("serviceTypeId").value = data.id;
        document.getElementById("serviceTypeName").value = data.name;
        document.getElementById("serviceTypeDescription").value = data.description;

        new bootstrap.Modal(document.getElementById("addServiceTypeModal")).show();
    }


    function deleteRow(id, row) {
        if (!confirm("Are you sure you want to delete this service type?")) return;

        document.body.classList.add("loading");

        fetch(`/api/servicetype/delete/${id}`, { method: "DELETE" })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    row.delete();
                    toastr.success(res.message);
                } else {
                    toastr.error(res.error);
                }
            })
            .finally(() => document.body.classList.remove("loading"));
    }

    document.getElementById("serviceTypeForm").addEventListener("submit", function (e) {
        e.preventDefault();

        const id = document.getElementById("serviceTypeId").value;

        const dto = {
            id: id ? parseInt(id) : 0,
            name: document.getElementById("serviceTypeName").value,
            description: document.getElementById("serviceTypeDescription").value
        };

        document.body.classList.add("loading");

        fetch("/api/servicetype/upsert", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(dto)
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {

                const row = res.data;

                if (dto.id === 0) {
                    table.addData([row], true);
                } else {
                    table.updateData([row]);
                }

                toastr.success(res.message);
                bootstrap.Modal.getInstance(document.getElementById("addServiceTypeModal")).hide();
            } else {
                toastr.error(res.error);
            }
        })
        .finally(() => document.body.classList.remove("loading"));
    });
</script>
