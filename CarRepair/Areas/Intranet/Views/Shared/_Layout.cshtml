<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="h-100">

    <nav class="navbar navbar-dark bg-dark d-md-none px-3">
        <a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="navbar-brand">
            Work Panel
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mobileMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </nav>

    <div class="collapse d-lg-none bg-dark" id="mobileMenu">
        <ul class="nav flex-column p-3">
            <li class="nav-item">
                <a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Dashboard</a>
            </li>
            <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Repairs</a></li>
            <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Tasks</a></li>
            <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Employees</a></li>
            <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Cars</a></li>
            <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Clients</a></li>
            <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Services</a></li>
            <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Settings</a></li>
        </ul>
    </div>

    <div class="container-fluid h-100">
        <div class="row h-100">
            <nav class="col-md-3 col-lg-2 d-none d-lg-block bg-dark text-white p-3">
                <a asp-area="Intranet" asp-controller="Home" asp-action="Index"
                   class="d-flex align-items-center mb-3 text-white text-decoration-none">
                    <span class="fs-4">Work Panel</span>
                </a>

                <hr class="border-secondary" />

                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item">
                        <a asp-area="Intranet" asp-controller="Home" asp-action="Index"
                           class="nav-link text-white">Dashboard</a>
                    </li>
                    <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Repairs</a></li>
                    <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Tasks</a></li>
                    <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Employees</a></li>
                    <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Cars</a></li>
                    <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Clients</a></li>
                    <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Services</a></li>
                    <li><a asp-area="Intranet" asp-controller="Home" asp-action="Index" class="nav-link text-white">Settings</a></li>
                </ul>

                <hr class="border-secondary" />

                <div class="text-center text-secondary">
                    @(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Guest")
                </div>
            </nav>

            <main class="col-md-9 col-lg-10 p-4 bg-light h-100 overflow-auto">
                <h1 class="mb-4">@ViewData["Title"]</h1>

                <div class="border border-2 border-secondary border-opacity-50 rounded p-4 bg-white">
                    @RenderBody()
                </div>
            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
