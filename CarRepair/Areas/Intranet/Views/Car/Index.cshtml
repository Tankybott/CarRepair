@model Model.ViewModel.IntranetCarViewModel

@{
    ViewData["Title"] = "Cars";
}

<link href="https://unpkg.com/tabulator-tables@5.5.0/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
<script src="https://unpkg.com/tabulator-tables@5.5.0/dist/js/tabulator.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-4 h-100">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Cars</h2>
    </div>

    <div id="carTable"></div>
</div>

<script>
    var tableData = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.Cars,
            new System.Text.Json.JsonSerializerOptions {
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            }
        )
    );

    var table = new Tabulator("#carTable", {
        index: "id",
        data: tableData,
        layout: "fitColumns",
        pagination: "local",
        paginationSize: 10,
        height: "90%",
        movableColumns: true,
        responsiveLayout: "collapse",

        columns: [
            {
                title: "Registration",
                field: "registrationNumber",
                headerFilter: "input",
                headerFilterPlaceholder: "Search..."
            },

            {
                title: "Owner",
                field: "ownerFullName",
                headerFilter: "input",
                headerFilterPlaceholder: "Search..."
            },

            {
                title: "Actions",
                formatter: () => `
                    <button class="btn btn-sm btn-info me-2 repairs-btn" title="Show car repairs">
                        <i class="bi bi-wrench"></i>
                    </button>

                    <button class="btn btn-sm btn-warning edit-btn" title="Edit car">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                `,
                width: 150,
                hozAlign: "center",
                cellClick: (e, cell) => {
                    const data = cell.getRow().getData();

                    if (e.target.closest(".repairs-btn")) {
                        showCarRepairs(data.id);
                    }

                    if (e.target.closest(".edit-btn")) {
                        editCar(data.id);
                    }
                }
            }
        ]
    });

    function showCarRepairs(id) {
        console.log("Show repairs for car:", id);
    }

    function editCar(id) {
        console.log("Edit car:", id);
    }
</script>
