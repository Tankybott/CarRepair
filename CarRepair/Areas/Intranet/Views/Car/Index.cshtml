@model Model.ViewModel.IntranetCarViewModel
@using Model.DomainModel

@{
    ViewData["Title"] = "Cars";
}

<link href="https://unpkg.com/tabulator-tables@5.5.0/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
<script src="https://unpkg.com/tabulator-tables@5.5.0/dist/js/tabulator.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    .loading {
        cursor: wait !important;
    }
</style>

<div class="container mt-4 h-100">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Cars</h2>
        <button class="btn btn-primary" onclick="openAddModal()">
            Add New
        </button>
    </div>

    <div id="carTable"></div>
</div>

<div class="modal fade" id="carModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="carForm">

                <input type="hidden" id="carId" />

                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Add Car</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Owner (Client)</label>
                        <select class="form-select" id="carClientId" required>
                            <option value="">-- Select Client --</option>
                            @foreach (var client in Model.Clients)
                            {
                                <option value="@client.Id">@client.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Brand</label>
                            <input class="form-control" id="carBrand" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Model</label>
                            <input class="form-control" id="carModel" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">VIN</label>
                            <input class="form-control" id="carVIN" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Year</label>
                            <input class="form-control" type="number" min="1886" max="2100" id="carYear" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Engine Code</label>
                        <input class="form-control" id="carEngineCode" required />
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fuel Type</label>
                            <select class="form-select" id="carFuelType">
                                @foreach (var val in Enum.GetValues<FuelType>())
                                {
                                    <option value="@((int)val)">@val.ToString()</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Transmission</label>
                            <select class="form-select" id="carTransmission">
                                @foreach (var val in Enum.GetValues<TransmissionType>())
                                {
                                    <option value="@((int)val)">@val.ToString()</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Body Type</label>
                            <select class="form-select" id="carBodyType">
                                @foreach (var val in Enum.GetValues<BodyType>())
                                {
                                    <option value="@((int)val)">@val.ToString()</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Client Notes</label>
                        <textarea class="form-control" id="carClientNotes" rows="2"></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>

            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="carInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Car Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Owner</label>
                        <p id="infoOwner" class="form-control-plaintext border-bottom"></p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">VIN</label>
                        <p id="infoVIN" class="form-control-plaintext border-bottom"></p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Brand</label>
                        <p id="infoBrand" class="form-control-plaintext border-bottom"></p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Model</label>
                        <p id="infoModel" class="form-control-plaintext border-bottom"></p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Year</label>
                        <p id="infoYear" class="form-control-plaintext border-bottom"></p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Engine Code</label>
                        <p id="infoEngineCode" class="form-control-plaintext border-bottom"></p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Fuel Type</label>
                        <p id="infoFuelType" class="form-control-plaintext border-bottom"></p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Transmission</label>
                        <p id="infoTransmission" class="form-control-plaintext border-bottom"></p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Body Type</label>
                        <p id="infoBodyType" class="form-control-plaintext border-bottom"></p>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Client Notes</label>
                    <p id="infoClientNotes" class="form-control-plaintext border-bottom"></p>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<script>
    var tableData = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.Cars,
            new System.Text.Json.JsonSerializerOptions {
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            }
        )
    );

    var table = new Tabulator("#carTable", {
        index: "id",
        data: tableData,
        layout: "fitColumns",
        pagination: "local",
        paginationSize: 10,
        height: "90%",
        movableColumns: true,
        responsiveLayout: "collapse",

        columns: [
            { title: "Brand", field: "brand", headerFilter: "input" },
            { title: "Model", field: "model", headerFilter: "input" },
            { title: "VIN", field: "vIN", headerFilter: "input" },
            { title: "Owner", field: "ownerFullName", headerFilter: "input" },
            {
                title: "Actions",
                formatter: () => `
                    <button class="btn btn-sm btn-info me-1 info-btn" title="Car Info">
                        <i class="bi bi-info-circle"></i>
                    </button>
                    <button class="btn btn-sm btn-warning me-1 edit-btn" title="Edit">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button class="btn btn-sm btn-danger delete-btn" title="Delete">
                        <i class="bi bi-trash"></i>
                    </button>
                `,
                width: 150,
                hozAlign: "center",
                cellClick: (e, cell) => {
                    const data = cell.getRow().getData();
                    if (e.target.closest(".info-btn")) openInfoModal(data);
                    if (e.target.closest(".edit-btn")) openEditModal(data);
                    if (e.target.closest(".delete-btn")) deleteRow(data.id, cell.getRow());
                }
            }
        ]
    });

    function openAddModal() {
        document.getElementById("modalTitle").innerText = "Add Car";
        document.getElementById("carId").value = "";
        document.getElementById("carClientId").value = "";
        document.getElementById("carBrand").value = "";
        document.getElementById("carModel").value = "";
        document.getElementById("carVIN").value = "";
        document.getElementById("carYear").value = "";
        document.getElementById("carEngineCode").value = "";
        document.getElementById("carFuelType").value = "0";
        document.getElementById("carTransmission").value = "0";
        document.getElementById("carBodyType").value = "0";
        document.getElementById("carClientNotes").value = "";
        new bootstrap.Modal(document.getElementById("carModal")).show();
    }

    function openEditModal(data) {
        document.getElementById("modalTitle").innerText = "Edit Car";
        document.getElementById("carId").value = data.id;
        document.getElementById("carClientId").value = data.clientId;
        document.getElementById("carBrand").value = data.brand;
        document.getElementById("carModel").value = data.model;
        document.getElementById("carVIN").value = data.vIN;
        document.getElementById("carYear").value = data.year;
        document.getElementById("carEngineCode").value = data.engineCode;
        document.getElementById("carFuelType").value = data.fuelTypeValue;
        document.getElementById("carTransmission").value = data.transmissionValue;
        document.getElementById("carBodyType").value = data.bodyTypeValue;
        document.getElementById("carClientNotes").value = data.clientNotes || "";
        new bootstrap.Modal(document.getElementById("carModal")).show();
    }

    function openInfoModal(data) {
        document.getElementById("infoOwner").innerText = data.ownerFullName;
        document.getElementById("infoBrand").innerText = data.brand;
        document.getElementById("infoModel").innerText = data.model;
        document.getElementById("infoVIN").innerText = data.vIN;
        document.getElementById("infoYear").innerText = data.year;
        document.getElementById("infoEngineCode").innerText = data.engineCode;
        document.getElementById("infoFuelType").innerText = data.fuelType;
        document.getElementById("infoTransmission").innerText = data.transmission;
        document.getElementById("infoBodyType").innerText = data.bodyType;
        document.getElementById("infoClientNotes").innerText = data.clientNotes || "—";
        new bootstrap.Modal(document.getElementById("carInfoModal")).show();
    }

    function deleteRow(id, row) {
        if (!confirm("Are you sure you want to delete this car?")) return;

        document.body.classList.add("loading");

        fetch(`/api/car/delete/${id}`, { method: "DELETE" })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    row.delete();
                    toastr.success(res.message);
                } else {
                    toastr.error(res.error);
                }
            })
            .finally(() => document.body.classList.remove("loading"));
    }

    document.getElementById("carForm").addEventListener("submit", function (e) {
        e.preventDefault();

        const id = document.getElementById("carId").value;

        const dto = {
            id: id ? parseInt(id) : 0,
            clientId: parseInt(document.getElementById("carClientId").value),
            brand: document.getElementById("carBrand").value,
            model: document.getElementById("carModel").value,
            vIN: document.getElementById("carVIN").value,
            year: parseInt(document.getElementById("carYear").value),
            engineCode: document.getElementById("carEngineCode").value,
            fuelType: parseInt(document.getElementById("carFuelType").value),
            transmission: parseInt(document.getElementById("carTransmission").value),
            bodyType: parseInt(document.getElementById("carBodyType").value),
            clientNotes: document.getElementById("carClientNotes").value || null
        };

        document.body.classList.add("loading");

        fetch("/api/car/upsert", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(dto)
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                const row = res.data;

                if (dto.id === 0) {
                    table.addData([row], true);
                } else {
                    table.updateData([row]);
                }

                toastr.success(res.message);
                bootstrap.Modal.getInstance(document.getElementById("carModal")).hide();
            } else {
                toastr.error(res.error);
            }
        })
        .finally(() => document.body.classList.remove("loading"));
    });
</script>
