@model Model.ViewModel.IntranetPartIndexVM
@using Model.DomainModel

@{
    ViewData["Title"] = "Parts";
}

<link href="https://unpkg.com/tabulator-tables@5.5.0/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
<script src="https://unpkg.com/tabulator-tables@5.5.0/dist/js/tabulator.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    .loading {
        cursor: wait !important;
    }
</style>

<div class="container mt-4 h-100">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Parts</h2>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">Filter by Status</label>
            <select id="statusFilter" class="form-select">
                <option value="">All Statuses</option>
                @foreach (var status in Enum.GetValues<PartStatus>())
                {
                    <option value="@status.ToString()">@status.ToString()</option>
                }
            </select>
        </div>
    </div>

    <div id="partTable"></div>
</div>

<div class="modal fade" id="partModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="partForm">

                <input type="hidden" id="partId" />

                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Add Part</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Repair ID</label>
                        <input class="form-control" type="number" min="1" id="partRepairId" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" id="partName" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Serial Number</label>
                        <input class="form-control" id="partSerialNumber" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Manufacturer</label>
                        <input class="form-control" id="partManufacturer" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="partDescription" rows="2"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Unit Price</label>
                            <input class="form-control" type="number" step="0.01" min="0" id="partUnitPrice" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Quantity</label>
                            <input class="form-control" type="number" min="1" id="partQuantity" required />
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>

            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form id="statusForm">

                <input type="hidden" id="statusPartId" />

                <div class="modal-header">
                    <h5 class="modal-title">Change Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">New Status</label>
                        <select class="form-select" id="statusSelect">
                            @foreach (var status in Enum.GetValues<PartStatus>())
                            {
                                <option value="@((int)status)">@status.ToString()</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    var tableData = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.Items,
            new System.Text.Json.JsonSerializerOptions {
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            }
        )
    );

    const statusColors = {
        "Pending": "secondary",
        "Ordered": "primary",
        "Delivered": "info",
        "Installed": "success",
        "Cancelled": "danger"
    };

    var table = new Tabulator("#partTable", {
        index: "id",
        data: tableData,
        layout: "fitColumns",
        pagination: "local",
        paginationSize: 10,
        height: "90%",
        movableColumns: true,
        responsiveLayout: "collapse",

        columns: [
            { title: "Repair ID", field: "repairId", headerFilter: "input", width: 120 },
            { title: "Name", field: "name", headerFilter: "input" },
            { title: "Serial Number", field: "serialNumber", headerFilter: "input" },
            {
                title: "Status",
                field: "status",
                formatter: (cell) => {
                    const color = statusColors[cell.getValue()] || "secondary";
                    return `<span class="badge bg-${color}">${cell.getValue()}</span>`;
                }
            },
            {
                title: "Actions",
                formatter: () => `
                    <button class="btn btn-sm btn-warning me-1 edit-btn" title="Edit">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button class="btn btn-sm btn-info me-1 status-btn" title="Change Status">
                        <i class="bi bi-arrow-repeat"></i>
                    </button>
                    <button class="btn btn-sm btn-danger delete-btn" title="Delete">
                        <i class="bi bi-trash"></i>
                    </button>
                `,
                width: 160,
                hozAlign: "center",
                cellClick: (e, cell) => {
                    const data = cell.getRow().getData();

                    if (e.target.closest(".edit-btn")) openEditModal(data);
                    if (e.target.closest(".status-btn")) openStatusModal(data);
                    if (e.target.closest(".delete-btn")) deleteRow(data.id, cell.getRow());
                }
            }
        ]
    });

    document.getElementById("statusFilter").addEventListener("change", function () {
        const value = this.value;
        if (value === "") {
            table.clearFilter();
        } else {
            table.setFilter("status", "=", value);
        }
    });

    function openAddModal() {
        document.getElementById("modalTitle").innerText = "Add Part";
        document.getElementById("partId").value = "";
        document.getElementById("partRepairId").value = "";
        document.getElementById("partName").value = "";
        document.getElementById("partSerialNumber").value = "";
        document.getElementById("partManufacturer").value = "";
        document.getElementById("partDescription").value = "";
        document.getElementById("partUnitPrice").value = "";
        document.getElementById("partQuantity").value = "1";
        new bootstrap.Modal(document.getElementById("partModal")).show();
    }

    function openEditModal(data) {
        document.getElementById("modalTitle").innerText = "Edit Part";
        document.getElementById("partId").value = data.id;
        const repairIdInput = document.getElementById("partRepairId");
        repairIdInput.value = data.repairId;
        repairIdInput.readOnly = true;
        document.getElementById("partName").value = data.name;
        document.getElementById("partSerialNumber").value = data.serialNumber;
        document.getElementById("partManufacturer").value = data.manufacturer || "";
        document.getElementById("partDescription").value = data.description || "";
        document.getElementById("partUnitPrice").value = data.unitPrice;
        document.getElementById("partQuantity").value = data.quantity;
        new bootstrap.Modal(document.getElementById("partModal")).show();
    }

    function openStatusModal(data) {
        document.getElementById("statusPartId").value = data.id;
        document.getElementById("statusSelect").value = data.statusValue;
        new bootstrap.Modal(document.getElementById("statusModal")).show();
    }

    function deleteRow(id, row) {
        if (!confirm("Are you sure you want to delete this part?")) return;

        document.body.classList.add("loading");

        fetch(`/api/part/delete/${id}`, { method: "DELETE" })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    row.delete();
                    toastr.success(res.message);
                } else {
                    toastr.error(res.error);
                }
            })
            .finally(() => document.body.classList.remove("loading"));
    }

    document.getElementById("partForm").addEventListener("submit", function (e) {
        e.preventDefault();

        const id = document.getElementById("partId").value;

        const dto = {
            id: id ? parseInt(id) : 0,
            repairId: parseInt(document.getElementById("partRepairId").value),
            name: document.getElementById("partName").value,
            serialNumber: document.getElementById("partSerialNumber").value,
            manufacturer: document.getElementById("partManufacturer").value || null,
            description: document.getElementById("partDescription").value || null,
            unitPrice: parseFloat(document.getElementById("partUnitPrice").value),
            quantity: parseInt(document.getElementById("partQuantity").value)
        };

        document.body.classList.add("loading");

        fetch("/api/part/upsert", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(dto)
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                const row = res.data;

                if (dto.id === 0) {
                    table.addData([row], true);
                } else {
                    table.updateData([row]);
                }

                toastr.success(res.message);
                bootstrap.Modal.getInstance(document.getElementById("partModal")).hide();
            } else {
                toastr.error(res.error);
            }
        })
        .finally(() => document.body.classList.remove("loading"));
    });

    document.getElementById("statusForm").addEventListener("submit", function (e) {
        e.preventDefault();

        const id = document.getElementById("statusPartId").value;
        const dto = { status: parseInt(document.getElementById("statusSelect").value) };

        document.body.classList.add("loading");

        fetch(`/api/part/status/${id}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(dto)
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                table.updateData([res.data]);
                toastr.success(res.message);
                bootstrap.Modal.getInstance(document.getElementById("statusModal")).hide();
            } else {
                toastr.error(res.error);
            }
        })
        .finally(() => document.body.classList.remove("loading"));
    });
</script>
