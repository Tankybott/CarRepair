@{
    ViewData["Title"] = "Welcome";
}

<div class="container py-5">
    <div class="row align-items-center">

        <div class="col-md-6 d-none d-md-block">
            <img src="/images/landing.jpg" class="img-fluid" alt="Car diagnostics illustration">
        </div>

        <div class="col-md-6">
            <h1 class="display-5 fw-bold mb-3">Welcome back, [Employee Name]!</h1>
            <p class="lead mb-4">
                Here's your hub for everything you need — check your latest updates, submit requests, and stay connected with your team.
            </p>
        </div>

    </div>
</div>
