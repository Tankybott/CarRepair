@{
    ViewData["Title"] = "Welcome";
}

<div class="container py-5">
    <div class="row align-items-center">

        <div class="col-md-6 d-none d-md-block">
            <img src="/images/landing.jpg" class="img-fluid" alt="Car diagnostics illustration">
        </div>

        <div class="col-md-6">
            <h1 class="display-5 fw-bold mb-3">Fast & Transparent Car Repair Estimates</h1>

