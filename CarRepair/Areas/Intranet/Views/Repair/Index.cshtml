@model Model.ViewModel.IntranetRepairViewModel
@using Model.DomainModel

@{
    ViewData["Title"] = "Repairs";
}

<link href="https://unpkg.com/tabulator-tables@5.5.0/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
<script src="https://unpkg.com/tabulator-tables@5.5.0/dist/js/tabulator.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    .loading { cursor: wait !important; }
</style>

<div class="container mt-4 h-100">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Repairs</h2>
        <button class="btn btn-primary" onclick="openAddModal()">Add New</button>
    </div>

    <div id="repairTable"></div>
</div>

<div class="modal fade" id="repairModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="repairForm">

                <div class="modal-header">
                    <h5 class="modal-title">Add Repair</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Client</label>
                        <select class="form-select" id="repairClientId" required>
                            <option value="">-- Select Client --</option>
                            @foreach (var client in Model.Clients)
                            {
                                <option value="@client.Id">@client.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Car</label>
                        <select class="form-select" id="repairCarId" required disabled>
                            <option value="">-- Select Client first --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Services</label>
                        <div class="border rounded p-3" style="max-height: 180px; overflow-y: auto;">
                            @if (!Model.Services.Any())
                            {
                                <span class="text-muted small">No services available.</span>
                            }
                            @foreach (var svc in Model.Services)
                            {
                                <div class="form-check">
                                    <input class="form-check-input svc-checkbox" type="checkbox" value="@svc.Id" id="svc_@svc.Id" />
                                    <label class="form-check-label" for="svc_@svc.Id">
                                        @svc.ServiceName
                                        <span class="text-muted small ms-1">(@svc.ServiceType)</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Client Description</label>
                        <textarea class="form-control" id="repairDescription" rows="3" required></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    var tableData = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.Repairs,
            new System.Text.Json.JsonSerializerOptions {
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            }
        )
    );

    var table = new Tabulator("#repairTable", {
        index: "id",
        data: tableData,
        layout: "fitColumns",
        pagination: "local",
        paginationSize: 10,
        height: "90%",
        movableColumns: true,
        responsiveLayout: "collapse",

        columns: [
            { title: "ID", field: "id", width: 70 },
            { title: "Client Name", field: "clientName", headerFilter: "input" },
            { title: "Client Surname", field: "clientSurname", headerFilter: "input" },
            { title: "Car", field: "carLabel" },
            { title: "Status", field: "status" },
            {
                title: "Actions",
                formatter: () => `
                    <button class="btn btn-sm btn-primary manage-btn" title="Manage Repair">
                        <i class="bi bi-tools"></i> Manage
                    </button>
                `,
                width: 130,
                hozAlign: "center",
                cellClick: (e, cell) => {
                    const data = cell.getRow().getData();
                    if (e.target.closest(".manage-btn")) manageRepair(data.id);
                }
            }
        ]
    });

    function manageRepair(id) {
        window.location.href = `/Intranet/Repair/Manage/${id}`;
    }

    function openAddModal() {
        document.getElementById("repairClientId").value = "";
        document.getElementById("repairCarId").innerHTML = '<option value="">-- Select Client first --</option>';
        document.getElementById("repairCarId").disabled = true;
        document.querySelectorAll(".svc-checkbox").forEach(cb => cb.checked = false);
        document.getElementById("repairDescription").value = "";
        new bootstrap.Modal(document.getElementById("repairModal")).show();
    }

    document.getElementById("repairClientId").addEventListener("change", function () {
        const clientId = this.value;
        const carSelect = document.getElementById("repairCarId");

        if (!clientId) {
            carSelect.innerHTML = '<option value="">-- Select Client first --</option>';
            carSelect.disabled = true;
            return;
        }

        carSelect.innerHTML = '<option value="">Loading...</option>';
        carSelect.disabled = true;

        fetch(`/api/repair/cars-by-client/${clientId}`)
            .then(r => r.json())
            .then(cars => {
                if (cars.length === 0) {
                    carSelect.innerHTML = '<option value="">No cars for this client</option>';
                } else {
                    carSelect.innerHTML = '<option value="">-- Select Car --</option>' +
                        cars.map(c => `<option value="${c.id}">${c.label}</option>`).join('');
                    carSelect.disabled = false;
                }
            })
            .catch(() => {
                carSelect.innerHTML = '<option value="">Failed to load cars</option>';
            });
    });

    document.getElementById("repairForm").addEventListener("submit", function (e) {
        e.preventDefault();

        const carId = document.getElementById("repairCarId").value;
        if (!carId) {
            toastr.error("Please select a car.");
            return;
        }

        const serviceIds = Array.from(document.querySelectorAll(".svc-checkbox:checked"))
            .map(cb => parseInt(cb.value));

        const dto = {
            carId: parseInt(carId),
            serviceIds,
            clientDescription: document.getElementById("repairDescription").value
        };

        document.body.classList.add("loading");

        fetch("/api/repair/create", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(dto)
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                table.addData([res.data], true);
                toastr.success(res.message);
                bootstrap.Modal.getInstance(document.getElementById("repairModal")).hide();
            } else {
                toastr.error(res.error);
            }
        })
        .finally(() => document.body.classList.remove("loading"));
    });
</script>
