@using Model.ViewModel
@model OfferViewModel

@{
    ViewData["Title"] = "Offer";
    var added = TempData["Added"] as string;
    int catIdx = 0;
}

@if (added is not null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
        <div id="addedToast" class="toast align-items-center text-bg-success border-0 show" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-cart-check me-2"></i> <strong>@added</strong> added to cart.
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
}

<div class="container py-4" style="max-width: 1600px;">

    @foreach (var category in Model.Categories)
    {
        string sectionBg = catIdx % 2 == 0 ? "#FAF9F6" : "#F9F6EE";
        catIdx++;

        <div class="mb-4 rounded-4 px-4 pt-4 pb-3" style="background: @sectionBg;">
            <h2 class="fw-bold mb-1">@category.Name</h2>
            <p class="text-muted mb-3">@category.Description</p>

            <div class="row g-3">

                @foreach (var item in category.Services)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <form asp-area="Portal" asp-controller="Offer" asp-action="AddToBasket" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit"
                                    class="card h-100 border-0 shadow-sm rounded-4 p-4 w-100 text-start"
                                    style="background: #ffffff; cursor: pointer; transition: transform .15s ease, box-shadow .15s ease;"
                                    onmouseover="this.style.transform='translateY(-3px)'; this.classList.add('shadow');"
                                    onmouseout="this.style.transform='translateY(0)'; this.classList.remove('shadow');">

                                <h5 class="fw-bold">@item.ShortDescription</h5>
                                <p class="text-muted mb-2">@item.Description</p>

                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <span class="fw-bold text-warning">@item.EstimatedPrice €</span>
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-cart-plus"></i> Add
                                    </span>
                                </div>
                            </button>
                        </form>
                    </div>
                }

            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        document.querySelectorAll('.toast').forEach(el => {
            setTimeout(() => bootstrap.Toast.getOrCreateInstance(el).hide(), 3000);
        });
    </script>
}
