@using Model.DTOs.IntranetDto
@model IEnumerable<IntranetRepairReadDto>

@{
    ViewData["Title"] = "Repairs";
    var carId = (int)ViewData["CarId"]!;
}

<div class="py-2" style="max-width: 1200px;">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-area="Portal" asp-controller="CarAndRepair" asp-action="Index"
           class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left"></i> Back to Cars
        </a>
        <h2 class="fw-bold mb-0">Repairs</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No repairs found for this car.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var repair in Model)
            {
                <div class="col-12">
                    <a asp-area="Portal" asp-controller="Repairs" asp-action="Detail" asp-route-id="@repair.Id"
                       class="text-decoration-none">
                        <div class="card border-0 shadow-sm rounded-4 p-3 bg-body-secondary hover-shadow">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="fw-bold fs-5">Repair #@repair.Id</span>
                                    @{
                                        var badgeClass = repair.Status switch
                                        {
                                            "Pending" => "bg-secondary",
                                            "ManagerReviewed" => "bg-warning text-dark",
                                            "ClientAccepted" => "bg-primary",
                                            "Scheduled" => "bg-info text-dark",
                                            "Done" => "bg-success",
                                            "Cancelled" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass ms-2">@repair.Status</span>
                                </div>
                                <i class="bi bi-chevron-right text-muted fs-5"></i>
                            </div>

                            @if (!string.IsNullOrEmpty(repair.ClientDescription))
                            {
                                <p class="text-muted small mb-1 mt-2">@repair.ClientDescription</p>
                            }

                            @if (repair.ServiceNames.Any())
                            {
                                <div class="mt-2 d-flex flex-wrap gap-1">
                                    @foreach (var svc in repair.ServiceNames)
                                    {
                                        <span class="badge bg-light text-dark border">@svc</span>
                                    }
                                </div>
                            }
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
