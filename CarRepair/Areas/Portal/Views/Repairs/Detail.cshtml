@model Model.DTOs.IntranetDto.IntranetRepairManageDto
@using System.Text.Json

@{
    ViewData["Title"] = $"Repair #{Model.RepairId}";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    bool canAccept = Model.StatusValue < 2 && Model.CostEstimations.Any();
}

<link href="https://unpkg.com/tabulator-tables@5.5.0/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
<script src="https://unpkg.com/tabulator-tables@5.5.0/dist/js/tabulator.min.js"></script>

<div class="py-2" style="max-width: 1200px;">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-area="Portal" asp-controller="Repairs" asp-action="Index" asp-route-carId="@Model.CarId"
           class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left"></i> Back to Repairs
        </a>
        <h2 class="fw-bold mb-0">Repair #@Model.RepairId</h2>
        @{
            var badgeClass = Model.Status switch
            {
                "Pending" => "bg-secondary",
                "ManagerReviewed" => "bg-warning text-dark",
                "ClientAccepted" => "bg-primary",
                "Scheduled" => "bg-info text-dark",
                "Done" => "bg-success",
                "Cancelled" => "bg-danger",
                _ => "bg-secondary"
            };
        }
        <span class="badge @badgeClass fs-6">@Model.Status</span>
    </div>

    @if (Model.BookingStart.HasValue)
    {
        <div class="alert alert-info d-flex align-items-center gap-3 rounded-4 mb-4">
            <i class="bi bi-calendar-event fs-4"></i>
            <div>
                <strong>Your repair is scheduled:</strong>
                @Model.BookingStart.Value.ToString("dd MMM yyyy HH:mm")
                &ndash;
                @Model.BookingEnd!.Value.ToString("dd MMM yyyy HH:mm")
            </div>
        </div>
    }

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header fw-semibold bg-transparent border-0 pt-3 pb-0">
                    <i class="bi bi-car-front me-2"></i>Vehicle
                </div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-5">Brand / Model</dt>
                        <dd class="col-7">@Model.CarBrand @Model.CarModel</dd>
                        <dt class="col-5">Year</dt>
                        <dd class="col-7">@Model.CarYear</dd>
                        <dt class="col-5">VIN</dt>
                        <dd class="col-7"><code>@Model.CarVIN</code></dd>
                        <dt class="col-5">Engine Code</dt>
                        <dd class="col-7">@Model.CarEngineCode</dd>
                        <dt class="col-5">Fuel</dt>
                        <dd class="col-7">@Model.CarFuelType</dd>
                        <dt class="col-5">Transmission</dt>
                        <dd class="col-7">@Model.CarTransmission</dd>
                        <dt class="col-5">Body</dt>
                        <dd class="col-7">@Model.CarBodyType</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header fw-semibold bg-transparent border-0 pt-3 pb-0">
                    <i class="bi bi-info-circle me-2"></i>Repair Details
                </div>
                <div class="card-body">
                    <p class="fw-semibold mb-1">Your description:</p>
                    <p class="text-muted mb-3">@(string.IsNullOrEmpty(Model.ClientDescription) ? "—" : Model.ClientDescription)</p>

                    <p class="fw-semibold mb-1">Services:</p>
                    @if (!Model.Services.Any())
                    {
                        <p class="text-muted mb-0">No services assigned yet.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var svc in Model.Services)
                            {
                                <li class="small">
                                    <i class="bi bi-check2 text-success me-1"></i>
                                    @svc.ServiceName
                                    <span class="text-muted">(@svc.ServiceType)</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        @if (Model.CostEstimations.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header fw-semibold bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-receipt me-2"></i>Cost Estimation</span>
                        @if (canAccept)
                        {
                            <button class="btn btn-success btn-sm rounded-pill" onclick="acceptCosts()">
                                <i class="bi bi-check-circle me-1"></i> Accept Costs
                            </button>
                        }
                    </div>
                    <div class="card-body p-0 pt-2">
                        <div id="costTable"></div>
                    </div>
                </div>
            </div>
        }

        @if (Model.Parts.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header fw-semibold bg-transparent border-0 pt-3 pb-0">
                        <i class="bi bi-tools me-2"></i>Parts Used
                    </div>
                    <div class="card-body p-0 pt-2">
                        <div id="partsTable"></div>
                    </div>
                </div>
            </div>
        }

        @if (Model.OverheadCosts.Any())
        {
            <div class="col-12">
                <div class="card border-warning shadow-sm rounded-4">
                    <div class="card-header fw-semibold text-warning-emphasis bg-warning-subtle border-0 pt-3 pb-0">
                        <i class="bi bi-plus-slash-minus me-2"></i>Additional Costs
                    </div>
                    <div class="card-body p-0 pt-2">
                        <div id="overheadTable"></div>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@if (!string.IsNullOrEmpty(TempData["AcceptSuccess"]?.ToString()))
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index:1100">
        <div class="toast show align-items-center text-bg-success border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">Costs accepted successfully.</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    const repairId = @Model.RepairId;

    @if (Model.CostEstimations.Any())
    {
        <text>
    new Tabulator("#costTable", {
        data: @Html.Raw(JsonSerializer.Serialize(Model.CostEstimations, jsonOptions)),
        layout: "fitColumns",
        columns: [
            { title: "Name", field: "name" },
            { title: "Description", field: "description", formatter: c => c.getValue() || "—" },
            {
                title: "Cost", field: "cost", hozAlign: "right", width: 120,
                formatter: c => `€${parseFloat(c.getValue()).toFixed(2)}`,
                bottomCalc: "sum",
                bottomCalcFormatter: c => `<strong>€${parseFloat(c.getValue()).toFixed(2)}</strong>`
            }
        ]
    });
        </text>
    }

    @if (Model.Parts.Any())
    {
        <text>
    new Tabulator("#partsTable", {
        data: @Html.Raw(JsonSerializer.Serialize(Model.Parts, jsonOptions)),
        layout: "fitColumns",
        columns: [
            { title: "Name", field: "name" },
            { title: "Manufacturer", field: "manufacturer", formatter: c => c.getValue() || "—" },
            { title: "Serial No.", field: "serialNumber", formatter: c => `<code>${c.getValue()}</code>` },
            { title: "Qty", field: "quantity", width: 70, hozAlign: "center" },
            { title: "Unit Price", field: "unitPrice", hozAlign: "right", width: 110,
              formatter: c => `€${parseFloat(c.getValue()).toFixed(2)}` },
            { title: "Status", field: "status", width: 110,
              formatter: c => `<span class="badge bg-secondary">${c.getValue()}</span>` }
        ]
    });
        </text>
    }

    @if (Model.OverheadCosts.Any())
    {
        <text>
    new Tabulator("#overheadTable", {
        data: @Html.Raw(JsonSerializer.Serialize(Model.OverheadCosts, jsonOptions)),
        layout: "fitColumns",
        columns: [
            { title: "Name", field: "name" },
            { title: "Description", field: "description", formatter: c => c.getValue() || "—" },
            {
                title: "Cost", field: "cost", hozAlign: "right", width: 120,
                formatter: c => `€${parseFloat(c.getValue()).toFixed(2)}`,
                bottomCalc: "sum",
                bottomCalcFormatter: c => `<strong>€${parseFloat(c.getValue()).toFixed(2)}</strong>`
            }
        ]
    });
        </text>
    }

    function acceptCosts() {
        if (!confirm('Accept the cost estimation for this repair?')) return;

        fetch(`/api/portal/repair/accept-costs/${repairId}`, { method: 'POST' })
            .then(r => r.json())
            .then(res => {
                if (res.success) location.reload();
                else alert('Failed to accept costs.');
            })
            .catch(() => alert('Request failed.'));
    }
</script>
}
