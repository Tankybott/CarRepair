@{
    ViewData["Title"] = "Welcome";
}

<div class="container py-5" style="max-width: 1600px;">
    <div class="row align-items-center justify-content-between">

        <div class="col-md-6 order-1 order-md-0 d-flex justify-content-center mb-4 mb-md-0">
            <img src="/images/landing.jpg" class="img-fluid" alt="Car diagnostics illustration">
        </div>

        <div class="col-md-5 order-0 order-md-1">
            <h1 class="display-5 fw-bold mb-3">
                Fast & Transparent Car Repair Estimates
            </h1>

            <p class="lead mb-4">
                Enter your car details, describe the issue, upload photos, and receive a mechanic‑verified
                cost estimate before booking your appointment.
            </p>

            <a href="/Offer" class="btn btn-warning btn-lg w-100 w-md-auto">
                View Our Offer
            </a>
        </div>

    </div>
</div>
