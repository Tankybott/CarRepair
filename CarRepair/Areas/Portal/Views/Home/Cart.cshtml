@using Model.ViewModel
@model CartViewModel

<h2 class="mb-4">Your Repair Cart</h2>

@if (!Model.Services.Any())
{
    <div class="alert alert-info">Your cart is empty.</div>
}
else
{
    <div class="list-group mb-4">

        @foreach (var item in Model.Services)
        {
            <div class="list-group-item py-3">

                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="mb-1">@item.ServiceName</h5>
                        <p class="mb-1 text-muted">@item.ShortDescription</p>
                    </div>

                    <div class="text-end">
                        <span class="fw-bold">@item.EstimatedPrice €</span>
                    </div>
                </div>

            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center border-top pt-3">
        <h4 class="mb-0">Estimated Total:</h4>
        <h4 class="mb-0 text-warning">@Model.TotalEstimatedPrice €</h4>
    </div>

    <div class="mt-4 text-end">
        <a asp-action="Checkout" class="btn btn-warning btn-lg">
            Proceed
        </a>
    </div>
}
