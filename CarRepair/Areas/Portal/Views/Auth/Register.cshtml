@model Model.DTOs.IntranetDto.IntranetClientCreateDto

@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6">

        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h3 class="fw-bold mb-1">Create an account</h3>
            <p class="text-muted mb-4">Fill in your details to register</p>

            <form asp-area="Portal" asp-controller="Auth" asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="alert alert-danger small" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="Name" class="form-label fw-semibold">First name</label>
                        <input asp-for="Name" class="form-control" placeholder="John" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Surname" class="form-label fw-semibold">Last name</label>
                        <input asp-for="Surname" class="form-control" placeholder="Doe" />
                        <span asp-validation-for="Surname" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone number</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="+48123456789" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-warning w-100 fw-bold rounded-pill">Create Account</button>
            </form>

            <hr class="my-4" />

            <p class="text-center text-muted small mb-0">
                Already have an account?
                <a asp-area="Portal" asp-controller="Auth" asp-action="Login" class="text-warning fw-semibold">Sign in</a>
            </p>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
