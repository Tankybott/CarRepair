@using Model.ViewModel
@model CarAndRepairViewModel

@{
    ViewData["Title"] = "Your Cars & Repairs";
}

<div class="container py-4" style="max-width: 1400px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Your Cars</h2>

        <a asp-controller="CarAndRepair" asp-action="Add"
           class="btn btn-warning fw-bold">
            + Add Car
        </a>
    </div>

    <div class="row g-3">

        @foreach (var car in Model.Cars)
        {
        <div class="col-12 col-md-6 col-lg-4">

            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-body-secondary">

                <h4 class="fw-bold mb-1">@car.Brand @car.Model</h4>

                <div class="text-muted mb-1">
                    <strong>VIN:</strong> @car.VIN
                </div>

                <div class="text-muted mb-3">
                    <strong>Year:</strong> @car.Year
                </div>

                <div class="d-flex gap-2">

                    <a asp-controller="Repairs" asp-action="Index" asp-route-carId="@car.Id"
                       class="btn btn-dark w-50 fw-bold"
                       style="transition: transform .15s ease, box-shadow .15s ease;"
                       onmouseover="this.style.transform='translateY(-2px)'; this.classList.add('shadow');"
                       onmouseout="this.style.transform='translateY(0)'; this.classList.remove('shadow');">
                        Show Repairs
                    </a>

                    <a asp-controller="CarAndRepair" asp-action="Edit" asp-route-id="@car.Id"
                       class="btn btn-outline-dark w-50 fw-bold"
                       style="transition: transform .15s ease, box-shadow .15s ease;"
                       onmouseover="this.style.transform='translateY(-2px)'; this.classList.add('shadow');"
                       onmouseout="this.style.transform='translateY(0)'; this.classList.remove('shadow');">
                        Edit Info
                    </a>

                </div>

            </div>

        </div>
        }

    </div>

</div>
